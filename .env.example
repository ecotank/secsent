# ==========================================
# SecureOffice-AI Environment Template
# ==========================================

# Application General Settings
APP_NAME=SecureOffice-AI
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secureoffice_db
DB_USER=secureoffice_app
DB_PASSWORD=SecureOfficePass2026!
DB_SSL_MODE=disable

# Redis Cache & Broker Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO Object Storage (Ciphertext Blob Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=admin_minio
MINIO_ROOT_PASSWORD=MinioSecurePass2026!
MINIO_BUCKET_LETTERS=secureoffice-letters
MINIO_USE_SSL=false

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=letter_embeddings

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=5.0

# Crypto Service & Key Management Configuration
CRYPTO_SERVICE_URL=http://localhost:8081
MASTER_KEY_SECRET=ChangeThisInProductionTo256BitKeyHexString!

# Security & Authentication (JWT Secrets)
JWT_SECRET=SuperSecretJWTSigningKeyForDevelopmentPurposeOnly2026!
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
